<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/splash_background" android:clickable="true">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/splash_background" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/ringtools_splash_mark" android:layout_width="192dp" android:layout_height="192dp"
        android:layout_gravity="center" android:src="@drawable/splash_mark" android:scaleType="fitCenter" android:importantForAccessibility="no" />
</FrameLayout>
