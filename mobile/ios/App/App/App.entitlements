<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: host via scripts/configure-native.mjs (RINGTOOLS_APP_HOST). Vereist /.well-known/apple-app-site-association op de server. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:ringapeldoorn.nl</string>
	</array>
	<!-- Pushmeldingen (APNs). Xcode zet dit bij archiveren automatisch op "production". -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
