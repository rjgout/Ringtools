# Kopieer naar mobile/.env (wordt niet gecommit). Alles hier is publiek/niet-geheim en komt in de gebundelde app.
# De https-URL van de Ringtools-backend (zelfde als APP_BASE_URL op de server).
VITE_API_URL=https://ringapeldoorn.nl
# Capacitor/native identiteit. LET OP: voorlopige waarden; stem de definitieve app-ID's af met de eigenaar
# voordat je een app aanmaakt in App Store Connect of Play Console (ze zijn daarna niet meer te wijzigen).
RINGTOOLS_APP_ID=nl.ringapeldoorn.ringtools
RINGTOOLS_APP_NAME=Ringtools
