generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RINGPRESIDIUM
  RINGSECRETARIS
  RINGADMINISTRATEUR
  HOGERAAD
}

enum VoteStage {
  PRESIDIUM
  HOGERAAD
}

enum CallingStatus {
  PRESIDIUM_VOTING
  PRESIDIUM_PAUSED
  // Presidium akkoord (individueel of gezamenlijk); wacht op een expliciete, geautoriseerde vrijgave aan de hoge raad.
  PRESIDIUM_APPROVED
  HOGERAAD_VOTING
  HOGERAAD_PAUSED
  APPROVED
  PROCESSED
}

// Hoe een fase is afgerond: via individuele reacties in de app of via een vastgelegd gezamenlijk besluit in een vergadering.
enum DecisionMethod {
  INDIVIDUAL
  MEETING
}

enum AppointAuthority {
  NONE
  RINGPRESIDENT
  AANGEWEZEN_RAADGEVER
  AANGEWEZEN_HOGERAADSLID
}

// Herkomst van de functie op een voorstel: standaardroeping uit de catalogus, eigen roeping van de ring of (alleen overgangswebapp) vrije tekst.
enum FunctionSource {
  STANDAARD
  EIGEN
  VRIJE_TEKST
}

// Gestructureerde kerkelijke functie binnen de ring. Los van de Ringtools-rol (toegang): een rol geeft nooit kerkelijke bevoegdheid. ONBEKEND = nog niet vastgelegd
// (bijv. bestaande leden); daaraan worden nooit bevoegdheden gekoppeld.
enum ChurchFunctionCode {
  ONBEKEND
  RINGPRESIDENT
  EERSTE_RAADGEVER
  TWEEDE_RAADGEVER
  RINGSECRETARIS
  RINGADMINISTRATEUR
  HOGERAADSLID
  ANDERS
}

enum UnitKind {
  WIJK
  GEMEENTE
}

enum OndersteuningContext {
  AVONDMAALSVERGADERING
  RINGCONFERENTIE
}

// De 7 workflow-gebeurtenissen die zowel het notificatiecentrum, push als
// e-mail (via dezelfde centrale notify()-functie in src/lib/notifications.ts)
// voeden.
enum NotificationType {
  NEW_PROPOSAL
  ADVANCED_TO_HOGERAAD
  REINVITE
  PAUSED
  TASK_ASSIGNED
  TASK_COMPLETED
  REMINDER_30_DAYS
  SUPPORT_REMINDER
  // Presidiumakkoord is bereikt; het voorstel wacht op expliciete vrijgave aan de hoge raad (generiek, zonder namen).
  AWAITING_RELEASE
  // Ontheffingen (Fase C4): bewust neutrale, generieke meldingen ("vertrouwelijk voorstel"), nooit met namen of functies.
  CONFIDENTIAL_PROPOSAL
  CONFIDENTIAL_HOGERAAD
  CONFIDENTIAL_PAUSED
  CONFIDENTIAL_REMINDER
}

model User {
  id                        String    @id @default(cuid())
  name                      String
  email                     String    @unique
  role                      Role
  active                    Boolean   @default(true)
  passwordHash              String? // alleen gevuld voor de systeemadministrator (webmin)
  // E-mailmeldingen voor de workflow (stemuitnodigingen, taken, herinneringen)
  // zijn uit te zetten; de inlog-/magic-link-mail zelf blijft altijd werken.
  emailNotificationsEnabled Boolean   @default(true)
  // Optionele passkey-verificatie voor reguliere gebruikers (standaard uit).
  // De systeemadministrator (TOTP) is hiervan uitgezonderd en altijd verplicht.
  mfaEnabled                Boolean   @default(false)
  // Eerste voltooide login (accountactivatie). Leeg = uitgenodigd maar nog niet geactiveerd.
  activatedAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  magicLinkTokens     MagicLinkToken[]
  sessions            Session[]
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]
  totpCredential      TotpCredential?
  webauthnCredentials WebAuthnCredential[]
  webauthnChallenge   WebAuthnChallenge?
  recoveryCodes       RecoveryCode[]
  securityEvents      SecurityEvent[]
  memberships         RingMembership[]
  invitationsCreated  RingInvitation[]     @relation("InvitationCreatedBy")
  invitationsAccepted RingInvitation[]     @relation("InvitationAcceptedBy")
  openLinkTokens      OpenLinkToken[]
  devicePushTokens    DevicePushToken[]
  trustedDevices      TrustedDevice[]
  deviceEnrollments   DeviceEnrollment[]
  mfaPairings         MfaPairing[]

  createdCallings          Calling[]            @relation("CallingCreatedBy")
  eligibleVotes            EligibleVoter[]
  votes                    Vote[]
  roepenAssigned           Calling[]            @relation("RoepenAssignee")
  roepenDone               Calling[]            @relation("RoepenDoneBy")
  ondersteunenAssigned     Calling[]            @relation("OndersteunenAssignee")
  ondersteunenDone         Calling[]            @relation("OndersteunenDoneBy")
  aanstellenAssigned       Calling[]            @relation("AanstellenAssignee")
  aanstellenDone           Calling[]            @relation("AanstellenDoneBy")
  processedCallings        Calling[]            @relation("ProcessedBy")
  releasedCallings         Calling[]            @relation("HogeraadReleasedBy")
  groupDecisionsRegistered GroupDecision[]      @relation("GroupDecisionRegisteredBy")
  groupDecisionsPresided   GroupDecision[]      @relation("GroupDecisionPresiding")
  callingAudits            CallingAudit[]       @relation("CallingAuditActor")
  callingDrafts            CallingDraft[]       @relation("DraftCreatedBy")
  unitsResponsible         RingUnit[]           @relation("UnitResponsible")
  unitsDefaultRoepen       RingUnit[]           @relation("UnitDefaultRoepen")
  unitsDefaultOndersteunen RingUnit[]           @relation("UnitDefaultOndersteunen")
  unitsDefaultAanstellen   RingUnit[]           @relation("UnitDefaultAanstellen")
  smtpSettingsUpdatedBy    SmtpSettings[]
  ontheffingenCreated      Ontheffing[]         @relation("OntheffingCreatedBy")
  ontheffingPersons        OntheffingPerson[]   @relation("OntheffingPersonUser")
  ontheffingVoterRows      OntheffingVoter[]    @relation("OntheffingVoterUser")
  ontheffingVotes          OntheffingVote[]     @relation("OntheffingVoteUser")
  ontheffingDecisionsBy    OntheffingDecision[] @relation("OntheffingDecisionBy")
  ontheffingDecisionsPres  OntheffingDecision[] @relation("OntheffingDecisionPresiding")
  ontheffingAudits         OntheffingAudit[]    @relation("OntheffingAuditActor")

  @@index([role, active])
}

model MagicLinkToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  // Eenmalige inlogcode (alleen de hash) om in een geïnstalleerde PWA in te
  // loggen, omdat een e-maillink op iOS in Safari opent met een apart
  // cookie-opslag. Wordt na te veel foute pogingen ongeldig.
  codeHash     String?
  codeAttempts Int       @default(0)

  @@index([userId])
  @@index([expiresAt])
}

// Persoonlijke, kortlevende koppeling uit een e-mail naar één voorstel. Het
// token geeft GEEN toegang en logt niet in: het laat alleen kiezen hoe je
// verder gaat (browser, inloglink of melding naar de app) en bevat geen
// vertrouwelijke gegevens. Alleen de hash wordt opgeslagen.
model OpenLinkToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  callingId  String
  calling    Calling   @relation(fields: [callingId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  pushCount  Int       @default(0)
  lastPushAt DateTime?
  lastMailAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([callingId])
  @@index([expiresAt])
}

// Een sessie is pas volledig ingelogd zodra mfaAt gezet is. Direct na
// identiteitscontrole (magic link/adminwachtwoord) wordt een sessie met
// mfaAt=null aangemaakt ("wacht op MFA") met een korte levensduur; pas na
// geslaagde TOTP/passkey-verificatie wordt het token geroteerd (nieuwe rij)
// en krijgt de nieuwe sessie de volle levensduur + mfaAt=nu. getSessionUser()
// in src/lib/auth.ts geeft uitsluitend een gebruiker terug als mfaAt gezet
// is — dat is de enige plek die hele-applicatietoegang bepaalt, dus een
// gedeeltelijk ingelogde gebruiker kan nergens in de app komen.
model Session {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String         @unique
  userAgent      String?
  mfaAt          DateTime?
  // Tijdstip waarop in DEZE (nog wachtende) sessie een tweede factor is
  // bewezen of voor het eerst ingeschreven. Alleen daarmee mag een wachtende
  // sessie worden afgerond; "er bestaat een factor" is niet genoeg.
  factorProvedAt DateTime?
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  // Doorlopende (sliding) sessies: laatste activiteit, tijdstip van de laatste
  // tokenrotatie en de hash van het vorige token (kort geldig na rotatie,
  // zodat gelijktijdige verzoeken niet uitloggen). Zie src/lib/auth.ts.
  lastSeenAt     DateTime       @default(now())
  rotatedAt      DateTime?
  prevTokenHash  String?
  // E2.4a: sessie die via een vertrouwd toestel is aangemaakt (wachtwoordloos); verdwijnt met het toestel of bij uitzetten/intrekken.
  deviceId       String?
  device         TrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([prevTokenHash])
  @@index([deviceId])
}

// TOTP-configuratie voor het adminaccount (webmin). Eén rij per gebruiker;
// het secret wordt AES-256-GCM-versleuteld opgeslagen (zelfde sleutel als
// het SMTP-wachtwoord, src/lib/crypto.ts). confirmedAt is null tijdens een
// nog niet afgeronde inschrijving.
model TotpCredential {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted        String
  // Opnieuw instellen: het nieuwe secret wacht hier tot het bevestigd is; het
  // werkende secret (secretEncrypted + confirmedAt) blijft intussen onveranderd.
  pendingSecretEncrypted String?
  pendingCreatedAt       DateTime?
  confirmedAt            DateTime?
  lastUsedCounter        Int?
  failedAttempts         Int       @default(0)
  lockedUntil            DateTime?
  // Herstelcodepogingen hebben een eigen teller en tijdelijke lockout (los van TOTP-pogingen).
  recoveryFailedAttempts Int       @default(0)
  recoveryLockedUntil    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// Eén rij per geregistreerde passkey (WebAuthn/FIDO2). Een gebruiker kan
// meerdere apparaten registreren (telefoon, laptop, enz.).
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceLabel  String?
  transports   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// Transiënte WebAuthn-challenge tussen het opvragen van opties en de
// verificatie van het antwoord. Eén actieve challenge per gebruiker; wordt
// na gebruik (of verlopen) verwijderd.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Eenmalige herstelcodes, uitsluitend voor het adminaccount (TOTP). Alleen
// de hash wordt opgeslagen; de ruwe codes worden één keer getoond bij het
// (opnieuw) instellen van TOTP en daarna nergens bewaard.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum SecurityEventType {
  TOTP_ENROLLED
  TOTP_RESET
  TOTP_FAILED_ATTEMPT
  TOTP_LOCKED
  PASSKEY_REGISTERED
  PASSKEY_REMOVED
  PASSKEY_LOGIN_FAILED
  RECOVERY_CODE_USED
  RECOVERY_CODES_REGENERATED
  MFA_RESET_BY_ADMIN
  SESSION_REVOKED
  MFA_VERIFIED
  TRUSTED_DEVICE_PAIRING_CREATED
  TRUSTED_DEVICE_REGISTERED
  TRUSTED_DEVICE_REVOKED
  TRUSTED_DEVICE_LOGIN_ENABLED
  TRUSTED_DEVICE_LOGIN_DISABLED
  TRUSTED_DEVICE_LOGIN
}

// Beveiligingslogboek: nooit geheimen (codes, secrets, herstelcodes) in
// `detail`, uitsluitend korte, niet-vertrouwelijke omschrijvingen.
model SecurityEvent {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorUserId String?
  type        SecurityEventType
  detail      String?
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt])
}

model Calling {
  id            String        @id @default(cuid())
  personName    String
  functionTitle String
  status        CallingStatus @default(PRESIDIUM_VOTING)

  ringId String
  ring   Ring   @relation(fields: [ringId], references: [id])

  createdById String
  createdBy   User     @relation("CallingCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  approvedAt    DateTime?
  processedAt   DateTime?
  processedById String?
  processedBy   User?     @relation("ProcessedBy", fields: [processedById], references: [id])

  reminder30SentAt DateTime? // eenmalige herinnering 30 dagen na aanmaken

  // Aanmaakmeldingen (uitnodiging presidium + taakverantwoordelijken): "claim" met korte lease zodat één aanroep tegelijk verstuurt,
  // "notifiedAt" zodra alles is afgeleverd. Een mislukte levering wordt herhaald zonder dubbele meldingen (zie deliverCreationNotifications).
  creationNotifyClaimedAt DateTime?
  creationNotifiedAt      DateTime?

  // Melding aan de ringstaf dat het voorstel op vrijgave wacht (zelfde claim/lease-principe als de aanmaakmeldingen).
  releaseNotifyClaimedAt DateTime?
  releaseNotifiedAt      DateTime?

  // Presidiumakkoord en vrijgave aan de hoge raad (geen automatische doorstart).
  presidiumApprovedAt     DateTime?
  presidiumApprovalMethod DecisionMethod?
  hogeraadReleasedAt      DateTime?
  hogeraadReleasedById    String?
  hogeraadReleasedBy      User?           @relation("HogeraadReleasedBy", fields: [hogeraadReleasedById], references: [id])
  hogeraadApprovalMethod  DecisionMethod?
  groupDecisions          GroupDecision[]
  audits                  CallingAudit[]

  // Vastlegging bij indienen (Fase C3): wat er op dat moment gold, zodat latere wijzigingen in catalogus of unitnaam
  // een bestaand voorstel niet van betekenis veranderen. Alle velden zijn leeg bij voorstellen van vóór C3.
  unitId                 String?
  unit                   RingUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitNameSnapshot       String?
  unitKindSnapshot       UnitKind?
  functionSource         FunctionSource?
  functionCode           String?
  catalogVersion         String?
  procedureSnapshot      Json?
  procedureConfirmedAt   DateTime?
  procedureConfirmedById String?
  roepenExternalName     String?
  aanstellenExternalName String?

  // Taak: Roepen
  roepenAssigneeId String?
  roepenAssignee   User?     @relation("RoepenAssignee", fields: [roepenAssigneeId], references: [id])
  roepenDoneById   String?
  roepenDoneBy     User?     @relation("RoepenDoneBy", fields: [roepenDoneById], references: [id])
  roepenDoneAt     DateTime?

  // Taak: Ondersteunen
  ondersteunenAssigneeId String?
  ondersteunenAssignee   User?                 @relation("OndersteunenAssignee", fields: [ondersteunenAssigneeId], references: [id])
  ondersteunenDoneById   String?
  ondersteunenDoneBy     User?                 @relation("OndersteunenDoneBy", fields: [ondersteunenDoneById], references: [id])
  ondersteunenDoneAt     DateTime?
  ondersteunenContext    OndersteuningContext?

  // Taak: Aanstellen
  aanstellenAssigneeId String?
  aanstellenAssignee   User?     @relation("AanstellenAssignee", fields: [aanstellenAssigneeId], references: [id])
  aanstellenDoneById   String?
  aanstellenDoneBy     User?     @relation("AanstellenDoneBy", fields: [aanstellenDoneById], references: [id])
  aanstellenDoneAt     DateTime?

  eligibleVoters EligibleVoter[]
  votes          Vote[]
  notifications  Notification[]
  openLinkTokens OpenLinkToken[]

  @@index([ringId, status])
  @@index([status])
  @@index([processedAt])
  @@index([createdAt])
}

// Bevroren snapshot van wie stemgerechtigd was op het moment dat een
// stemfase startte, zodat latere wijzigingen in gebruikersbeheer een
// lopende stemming niet kunnen beinvloeden.
model EligibleVoter {
  id            String    @id @default(cuid())
  callingId     String
  calling       Calling   @relation(fields: [callingId], references: [id], onDelete: Cascade)
  stage         VoteStage
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  // Laatste keer dat deze persoon een uitnodiging of herinnering voor deze
  // ondersteuningsronde kreeg (basis voor de verzendbeperking).
  lastInvitedAt DateTime?

  @@unique([callingId, stage, userId])
  @@index([callingId, stage])
}

model Vote {
  id        String    @id @default(cuid())
  callingId String
  calling   Calling   @relation(fields: [callingId], references: [id], onDelete: Cascade)
  stage     VoteStage
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  support   Boolean
  votedAt   DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([callingId, stage, userId])
  @@index([callingId, stage])
}

model SmtpSettings {
  id                Int      @id @default(1)
  host              String?
  port              Int      @default(587)
  security          String   @default("STARTTLS") // NONE | TLS | STARTTLS
  username          String?
  encryptedPassword String? // AES-256-GCM, versleuteld met SETTINGS_ENCRYPTION_KEY
  fromAddress       String   @default("noreply@ringapeldoorn.nl")
  fromName          String   @default("Ringtools")
  updatedAt         DateTime @updatedAt
  updatedById       String?
  updatedBy         User?    @relation(fields: [updatedById], references: [id])
}

// Eén rij per geabonneerd apparaat/browser (Web Push). Eén gebruiker kan
// meerdere actieve subscriptions hebben (bv. iPhone + iPad).
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// Pushtoken van de native iOS/Android-app (Capacitor): APNs-token (ios) of FCM-token (android).
// Eén token per installatie; bij uitloggen, een ongeldig token of uitschakelen door de gebruiker
// wordt de rij verwijderd of op inactief gezet. lastSeenAt = laatste succesvolle registratie.
model DevicePushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // "ios" | "android"
  provider   String   @default("fcm") // "apns" | "fcm"
  deviceId   String? // stabiele installatie-ID van de app (voor tokenrotatie), nooit een hardware-ID
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([userId, deviceId])
}

// Interne meldingen voor het notificatiecentrum (de bel rechtsboven). Wordt
// altijd aangemaakt voor een relevante workflow-gebeurtenis, ongeacht of de
// ontvanger push/e-mail heeft uitgeschakeld voor die gebeurtenis.
model Notification {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ringId       String
  ring         Ring             @relation(fields: [ringId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  message      String
  targetUrl    String
  // Bij verwijdering van de roeping (bv. 30 dagen na verwerking) worden de
  // gekoppelde meldingen automatisch mee verwijderd.
  callingId    String?
  calling      Calling?         @relation(fields: [callingId], references: [id], onDelete: Cascade)
  // Idem voor ontheffingen: meldingen verdwijnen met het dossier.
  ontheffingId String?
  ontheffing   Ontheffing?      @relation(fields: [ontheffingId], references: [id], onDelete: Cascade)
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, ringId, readAt])
  @@index([userId, createdAt])
  @@index([callingId])
}

// Een ring is de tenant-grens: voorstellen, ondersteuningsrondes, taken en
// meldingen horen altijd bij precies één ring.
model Ring {
  id        String   @id @default(cuid())
  name      String   @unique
  // Een gedeactiveerde ring blijft bewaard maar is voor niemand meer toegankelijk
  // (ook niet voor leden); alleen de webmin beheert hem nog. Heractiveren herstelt alles.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    RingMembership[]
  invitations    RingInvitation[]
  units          RingUnit[]
  customCallings RingCustomCalling[]
  callings       Calling[]
  notifications  Notification[]
  callingDrafts  CallingDraft[]
  ontheffingen   Ontheffing[]
}

// Lidmaatschap van een gebruiker in een ring. `role` is de workflowrol binnen
// Ringtools (nooit ADMIN); `churchFunction` is de kerkelijke functie (vrije
// tekst) en heeft geen invloed op rechten; `isRingManager` geeft de
// administratieve bevoegdheid voor gebruikersbeheer in deze ring.
model RingMembership {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ringId             String
  ring               Ring               @relation(fields: [ringId], references: [id], onDelete: Cascade)
  role               Role
  churchFunction     String             @default("") // omschrijving/toelichting (vrije tekst); bepaalt nooit bevoegdheid
  // Gestructureerde functie; bepaalt welke bevoegdheden volgens de geverifieerde handboekprocedure mogelijk zijn (src/lib/churchFunctions.ts).
  churchFunctionCode ChurchFunctionCode @default(ONBEKEND)
  isRingManager      Boolean            @default(false)
  // Expliciete machtiging in deze ring (waar het handboek een "aangewezen" raadgever of hogeraadslid vraagt). Een Ringtools-rol of kerkelijke functie is op
  // zichzelf geen machtiging. De waarde RINGPRESIDENT is VEROUDERD en wordt niet meer toegekend: de functie ringpresident volstaat.
  appointAuthority   AppointAuthority   @default(NONE)
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([userId, ringId])
  @@index([ringId, active, role])
}

// Vastlegging van een daadwerkelijk in een vergadering genomen gezamenlijk besluit (presidium of hoge raad).
// Het is nooit een vervanging van individuele reacties: er worden geen reacties namens anderen aangemaakt.
// Verdwijnt samen met het voorstel (cascade), zodat dit geen blijvend personenregister wordt.
model GroupDecision {
  id                    String    @id @default(cuid())
  callingId             String
  calling               Calling   @relation(fields: [callingId], references: [id], onDelete: Cascade)
  stage                 VoteStage
  decidedOn             DateTime  @db.Date
  registeredById        String
  registeredBy          User      @relation("GroupDecisionRegisteredBy", fields: [registeredById], references: [id])
  registeredAt          DateTime  @default(now())
  agreed                Boolean // expliciete verklaring dat het besluit akkoord is vastgesteld
  note                  String?
  // Alleen hoge raad: presiderend lid van het ringpresidium en aanwezigheid (afwezig ≠ ondersteunend).
  presidingUserId       String?
  presidingUser         User?     @relation("GroupDecisionPresiding", fields: [presidingUserId], references: [id])
  presentUserIds        String[]
  absentUserIds         String[]
  // Eerdere negatieve reacties blijven bestaan; een oplossing wordt expliciet vastgelegd.
  overrodeNegativeVotes Boolean   @default(false)
  resolutionNote        String?

  @@unique([callingId, stage])
}

// Kort, tijdelijk auditspoor per voorstel (vrijgave, gezamenlijke besluiten). Verdwijnt met het voorstel.
model CallingAudit {
  id        String   @id @default(cuid())
  callingId String
  calling   Calling  @relation(fields: [callingId], references: [id], onDelete: Cascade)
  type      String
  actorId   String
  actor     User     @relation("CallingAuditActor", fields: [actorId], references: [id])
  createdAt DateTime @default(now())
  detail    String?

  @@index([callingId, createdAt])
}

// Wijk of gemeente in een ring: organisatorische instelling (geen ledenoverzicht). De koppeling aan een hogeraadslid wordt
// gebruikt om bij een nieuwe roeping automatisch het betrokken hogeraadslid voor te stellen en bepaalt NOOIT wie mag ondersteunen.
model RingUnit {
  id                        String   @id @default(cuid())
  ringId                    String
  ring                      Ring     @relation(fields: [ringId], references: [id], onDelete: Cascade)
  kind                      UnitKind
  name                      String
  active                    Boolean  @default(true)
  // Verantwoordelijk hogeraadslid (leeg = vacature). Eén hogeraadslid kan meerdere units hebben.
  responsibleUserId         String?
  responsibleUser           User?    @relation("UnitResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  // Standaardverantwoordelijken voor de uitvoeringstaken bij voorstellen uit deze unit.
  defaultRoepenUserId       String?
  defaultRoepenUser         User?    @relation("UnitDefaultRoepen", fields: [defaultRoepenUserId], references: [id], onDelete: SetNull)
  defaultOndersteunenUserId String?
  defaultOndersteunenUser   User?    @relation("UnitDefaultOndersteunen", fields: [defaultOndersteunenUserId], references: [id], onDelete: SetNull)
  defaultAanstellenUserId   String?
  defaultAanstellenUser     User?    @relation("UnitDefaultAanstellen", fields: [defaultAanstellenUserId], references: [id], onDelete: SetNull)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  callings Calling[]

  @@unique([ringId, name])
  @@index([ringId, active])
}

// Eigen roeping van één ring (alleen zichtbaar binnen die ring). Bewust zonder bevoegdheids- of procedureregels:
// de bevoegde leiding controleert de procedure en bevestigt dat bij gebruik.
model RingCustomCalling {
  id        String   @id @default(cuid())
  ringId    String
  ring      Ring     @relation(fields: [ringId], references: [id], onDelete: Cascade)
  name      String
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ringId, name])
  @@index([ringId, active])
}

// Concept van een roepingsvoorstel (Fase C3): mag onvolledig zijn, is alleen zichtbaar voor ringstaf van de eigen ring en
// heeft géén ondersteuningsronde en stuurt géén meldingen. Verlaten concepten worden na 30 dagen zonder wijziging verwijderd;
// na indienen worden de persoonsgegevens direct gewist en blijft alleen een korte sleutel (idempotentie) tot de opruiming.
model CallingDraft {
  id                     String          @id @default(cuid())
  ringId                 String
  ring                   Ring            @relation(fields: [ringId], references: [id], onDelete: Cascade)
  createdById            String
  createdBy              User            @relation("DraftCreatedBy", fields: [createdById], references: [id])
  personName             String?
  unitId                 String?
  functionSource         FunctionSource?
  functionCode           String?
  functionName           String?
  roepenAssigneeId       String?
  ondersteunenAssigneeId String?
  aanstellenAssigneeId   String?
  roepenExternalName     String?
  aanstellenExternalName String?
  procedureConfirmed     Boolean         @default(false)
  submittedCallingId     String?
  submittedAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([ringId, updatedAt])
  @@index([submittedAt])
}

// ---- Ontheffingen (Fase C4): zelfstandige module, los van Calling ----

enum OntheffingStatus {
  CONCEPT
  PRESIDIUM_VOTING
  PRESIDIUM_PAUSED
  // Presidium akkoord (individueel of gezamenlijk); wacht op een expliciete vrijgave aan de hoge raad.
  PRESIDIUM_APPROVED
  HOGERAAD_VOTING
  HOGERAAD_PAUSED
  // Besluit genomen: uitvoering per persoon (informeren, bekendmaken, verwerken).
  APPROVED
  PROCESSED
}

enum OntheffingPersonRole {
  HOOFD
  RAADGEVER
}

// Antwoord op de verplichte vervolgvraag per raadgever bij de ontheffing van een president(e).
enum FollowUpAnswer {
  OPEN
  NAAM
  NIET_VAN_TOEPASSING
}

// Tijdelijke, expliciete identificatie van het Ringtools-account van de betrokkene (nooit via de naam).
enum AccountLinkMode {
  ONBEKEND
  GEKOPPELD
  GEEN_ACCOUNT
}

// Betrokkenen zijn vertrouwelijk: de persoon (of het gekoppelde account) mag het dossier nergens kunnen ontdekken. Een dossier
// bevat alleen wat voor de procedure nodig is en verdwijnt 30 dagen na verwerking (concepten: 30 dagen zonder wijziging).
model Ontheffing {
  id          String           @id @default(cuid())
  ringId      String
  ring        Ring             @relation(fields: [ringId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User             @relation("OntheffingCreatedBy", fields: [createdById], references: [id])
  status      OntheffingStatus @default(CONCEPT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Wijk of gemeente van herkomst (verplicht bij indienen) en vastlegging van de gekozen functie en procedure.
  unitId               String?
  unitNameSnapshot     String?
  unitKindSnapshot     UnitKind?
  functionSource       FunctionSource?
  functionCode         String?
  functionName         String?
  catalogVersion       String?
  procedureSnapshot    Json?
  procedureConfirmed   Boolean         @default(false)
  procedureConfirmedAt DateTime?
  // Gezamenlijke ontheffing: de functie kent verplichte vervolgvragen (president(e) en raadgevers).
  joint                Boolean         @default(false)

  submittedAt             DateTime?
  presidiumApprovedAt     DateTime?
  presidiumApprovalMethod DecisionMethod?
  hogeraadReleasedAt      DateTime?
  hogeraadReleasedById    String?
  hogeraadApprovalMethod  DecisionMethod?
  approvedAt              DateTime?
  processedAt             DateTime?

  // Laatste inhoudelijke activiteit (niet: technische bijwerkingen). Basis voor herinnering na 30 dagen en markering voor beoordeling na 90 dagen;
  // lopende dossiers worden nooit automatisch verwijderd zonder vastgesteld bewaarbeleid.
  lastActivityAt  DateTime  @default(now())
  reminderSentAt  DateTime?
  reviewFlaggedAt DateTime?

  // Herstelbare meldingen (zelfde principe als Calling.creationNotify*): welke gebeurtenis nog moet worden gemeld.
  notifyEvent     String?
  notifyClaimedAt DateTime?

  persons       OntheffingPerson[]
  voters        OntheffingVoter[]
  votes         OntheffingVote[]
  decisions     OntheffingDecision[]
  audits        OntheffingAudit[]
  notifications Notification[]

  @@index([ringId, status])
  @@index([status, updatedAt])
  @@index([processedAt])
}

model OntheffingPerson {
  id           String               @id @default(cuid())
  ontheffingId String
  ontheffing   Ontheffing           @relation(fields: [ontheffingId], references: [id], onDelete: Cascade)
  role         OntheffingPersonRole
  // Alleen bij RAADGEVER: catalogcode van de raadgeversfunctie uit de vervolgvraag.
  followUpCode String?
  functionName String
  answer       FollowUpAnswer       @default(OPEN)
  name         String?
  naReason     String?
  // Tijdelijke identificatie van het account; verdwijnt met het dossier.
  accountMode  AccountLinkMode      @default(ONBEKEND)
  userId       String?
  user         User?                @relation("OntheffingPersonUser", fields: [userId], references: [id], onDelete: SetNull)

  // Uitvoeringsstatus per persoon (geen fictieve afzonderlijke goedkeuringsbesluiten).
  informedAt    DateTime?
  informedById  String?
  announcedAt   DateTime?
  announcedById String?
  // Bij de bekendmaking vastgelegd: is gelegenheid tot dankbetuiging geboden? (niet: is er daadwerkelijk dank uitgesproken). Leeg tot de bekendmaking.
  thanksOffered Boolean?
  // VEROUDERD en niet meer gebruikt door de code (vervangen door thanksOffered). Bewust niet verwijderd zodat migraties strikt additief blijven;
  // wordt in een latere, aparte migratie opgeruimd zodra vaststaat dat nergens meer gegevens in staan.
  thankedAt     DateTime?
  processedAt   DateTime?
  processedById String?
  createdAt     DateTime  @default(now())

  @@unique([ontheffingId, followUpCode])
  @@index([ontheffingId])
  @@index([userId])
}

model OntheffingVoter {
  id            String     @id @default(cuid())
  ontheffingId  String
  ontheffing    Ontheffing @relation(fields: [ontheffingId], references: [id], onDelete: Cascade)
  stage         VoteStage
  userId        String
  user          User       @relation("OntheffingVoterUser", fields: [userId], references: [id], onDelete: Cascade)
  lastInvitedAt DateTime   @default(now())

  @@unique([ontheffingId, stage, userId])
  @@index([userId])
}

model OntheffingVote {
  id           String     @id @default(cuid())
  ontheffingId String
  ontheffing   Ontheffing @relation(fields: [ontheffingId], references: [id], onDelete: Cascade)
  stage        VoteStage
  userId       String
  user         User       @relation("OntheffingVoteUser", fields: [userId], references: [id], onDelete: Cascade)
  support      Boolean
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([ontheffingId, stage, userId])
}

model OntheffingDecision {
  id                    String     @id @default(cuid())
  ontheffingId          String
  ontheffing            Ontheffing @relation(fields: [ontheffingId], references: [id], onDelete: Cascade)
  stage                 VoteStage
  decidedOn             DateTime   @db.Date
  registeredById        String
  registeredBy          User       @relation("OntheffingDecisionBy", fields: [registeredById], references: [id])
  registeredAt          DateTime   @default(now())
  agreed                Boolean
  note                  String?
  presidingUserId       String?
  presidingUser         User?      @relation("OntheffingDecisionPresiding", fields: [presidingUserId], references: [id])
  presentUserIds        String[]
  absentUserIds         String[]
  overrodeNegativeVotes Boolean    @default(false)
  resolutionNote        String?

  @@unique([ontheffingId, stage])
}

// Kort auditspoor per dossier zonder namen of functies; verdwijnt met het dossier.
model OntheffingAudit {
  id           String     @id @default(cuid())
  ontheffingId String
  ontheffing   Ontheffing @relation(fields: [ontheffingId], references: [id], onDelete: Cascade)
  type         String
  actorId      String
  actor        User       @relation("OntheffingAuditActor", fields: [actorId], references: [id])
  createdAt    DateTime   @default(now())
  detail       String?

  @@index([ontheffingId, createdAt])
}

// ---- C5.1: uitnodigingen en accountactivatie ----

// Een uitnodiging legt vooraf vast wat een bevoegde ringbeheerder toekent (rol, functie, ringbeheerder ja/nee). Een machtiging
// (appointAuthority) maakt nooit deel uit van een uitnodiging: die wordt na activatie expliciet door de ringbeheerder vastgelegd.
// Alleen hashes van token en code worden bewaard; de ruwe waarden staan uitsluitend in de verstuurde e-mail.
// Status wordt afgeleid: acceptedAt → geactiveerd, revokedAt → ingetrokken, expiresAt < nu → verlopen, sentAt leeg → niet verstuurd.
model RingInvitation {
  id                 String             @id @default(cuid())
  ringId             String
  ring               Ring               @relation(fields: [ringId], references: [id], onDelete: Cascade)
  email              String // genormaliseerd (kleine letters)
  name               String
  role               Role
  churchFunction     String             @default("")
  churchFunctionCode ChurchFunctionCode @default(ONBEKEND)
  isRingManager      Boolean            @default(false)
  createdById        String?
  createdBy          User?              @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tokenHash          String             @unique
  codeHash           String
  codeAttempts       Int                @default(0)
  expiresAt          DateTime
  sentAt             DateTime?
  // Verzendclaim (lease): wie een verzending start zet dit; gelijktijdige verzoeken zien het en versturen niet nogmaals (idempotent).
  sendClaimedAt      DateTime?
  sendCount          Int                @default(0)
  revokedAt          DateTime?
  acceptedAt         DateTime?
  acceptedById       String?
  acceptedBy         User?              @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  audit RingInvitationAudit[]

  @@index([ringId, email])
  @@index([expiresAt])
}

enum InvitationAuditAction {
  CREATED
  SENT
  SEND_FAILED
  UPDATED
  REVOKED
  ACCEPTED
  ACCEPT_REFUSED
  CODE_FAILED
}

// Audittrail van uitnodigingen. `detail` bevat nooit tokens, codes of e-mailadressen.
model RingInvitationAudit {
  id           String                @id @default(cuid())
  invitationId String
  invitation   RingInvitation        @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  action       InvitationAuditAction
  actorUserId  String?
  detail       String?
  createdAt    DateTime              @default(now())

  @@index([invitationId, createdAt])
}

// ---- E2.3: vertrouwde toestellen (hardwaregebonden sleutel; vlag TRUSTED_DEVICES_ENABLED) ----

enum TrustedDevicePlatform {
  IOS
  ANDROID
}

// Een geregistreerd toestel is GEEN zelfstandige MFA-methode (E2.4 beoordeelt dat opnieuw). Zonder attestatie kan de server
// niet bewijzen dat de sleutel in hardware zit; dat staat in docs/E2-3-TOESTELSLEUTELS-ONDERZOEK.md.
model TrustedDevice {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String
  platform        TrustedDevicePlatform
  installationId  String                 @unique
  publicKey       String                 @unique // base64 SPKI (ECDSA P-256); nooit hergebruikt, ook niet na intrekking
  createdAt       DateTime               @default(now())
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  revokedById     String?
  // E2.4a: expliciete activering als inlogmethode (null = alleen geregistreerd, géén inlogmethode)
  loginEnabledAt  DateTime?
  sessions        Session[]
  loginChallenges DeviceLoginChallenge[]

  @@index([userId])
}

// Eenmalige koppelcode (alleen hashes). Autoriseert uitsluitend een toestelregistratie: geen sessie, geen MFA-goedkeuring.
model MfaPairing {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash       String    @unique
  expiresAt      DateTime
  claimedAt      DateTime?
  claimTokenHash String?   @unique
  challenge      String?
  claimExpiresAt DateTime?
  failedAttempts Int       @default(0)
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

enum DeviceChallengePurpose {
  LOGIN
  ACTIVATE
}

// E2.4a: eenmalige challenge voor wachtwoordloos inloggen (LOGIN) of het activeren van een toestel als inlogmethode (ACTIVATE).
// Gebonden aan één toestel en één doel; kort geldig; atomair te verbruiken. Elke challenge is een willekeurige waarde, niet te raden.
model DeviceLoginChallenge {
  id             String                 @id @default(cuid())
  deviceId       String
  device         TrustedDevice          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  purpose        DeviceChallengePurpose
  challenge      String
  expiresAt      DateTime
  failedAttempts Int                    @default(0)
  consumedAt     DateTime?
  createdAt      DateTime               @default(now())

  @@index([deviceId, createdAt])
}

// E2.5: eenmalige registratiechallenge voor het automatisch inrichten van Face ID-inloggen vanuit een volledig geauthenticeerde sessie
// (recente MFA). Gebonden aan één gebruiker; kort geldig; atomair te verbruiken. Een koppelcode is hiervoor niet nodig en levert nooit een sessie.
model DeviceEnrollment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge      String
  expiresAt      DateTime
  failedAttempts Int       @default(0)
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}
