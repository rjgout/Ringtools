# Kopieer dit bestand naar ".env" voor lokale ontwikkeling.
# Op de NAS zet je deze waarden in de Portainer stack (environment variables).

# Basis-URL waarmee de app vanaf buitenaf bereikbaar is (gebruikt voor de WhatsApp-links)
APP_BASE_URL=https://ringpresidium.jouwdomein.nl

# Geheime sleutel om sessies (login) te ondertekenen. Verander dit in iets langs en willekeurigs.
SESSION_SECRET=verander-dit-in-een-lange-willekeurige-tekst

# Zet op "true" zodra de app achter HTTPS (reverse proxy) draait. Zet op "false" voor lokaal testen zonder HTTPS.
COOKIE_SECURE=true

# Eerste admin-account (wordt automatisch aangemaakt/bijgewerkt bij het opstarten)
ADMIN_USERNAME=webmin
ADMIN_PASSWORD=ldstools123!

# SMTP-instellingen voor de automatische e-mail na 30 dagen. Leeg laten = e-mail wordt niet verstuurd
# (de roeping wordt dan ook niet automatisch verwijderd, zodat er geen data verloren gaat).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ringpresidium <noreply@jouwdomein.nl>

PORT=3000
