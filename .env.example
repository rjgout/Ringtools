# Kopieer dit bestand naar ".env" voor lokale ontwikkeling.
# Op de NAS zet je deze waarden als environment variables in de Portainer-stack.

# --- Database (PostgreSQL, draait als los onderdeel in dezelfde stack) ---
DATABASE_URL="postgresql://ringtools:verander-dit-wachtwoord@db:5432/ringtools?schema=public"

# --- Basis-URL waarmee de app bereikbaar is (gebruikt in e-maillinks) ---
# Zonder reverse proxy/domein: http://<NAS-IP>:2809
APP_BASE_URL="https://ringapeldoorn.nl"

# --- Optioneel: supportadres dat op de publieke pagina's (Contact, Accountverwijdering) wordt getoond. Leeg = verwijzing naar de ringbeheerder. ---
# PUBLIC_CONTACT_EMAIL=""

# --- Admin-account (webmin): wordt éénmalig aangemaakt bij de eerste start. ---
# Een later in de applicatie gewijzigd wachtwoord wordt bij een herstart NOOIT
# overschreven door deze waarde.
BOOTSTRAP_ADMIN_USERNAME="webmin"
BOOTSTRAP_ADMIN_PASSWORD="verander-dit-in-een-sterk-wachtwoord"

# --- Versleuteling van het SMTP-wachtwoord én de TOTP-secrets (MFA) ---
# Verplicht: een lange, willekeurige tekst (bijv. gegenereerd met
# `openssl rand -hex 32`). Bewaar deze goed: zonder deze sleutel kunnen het
# opgeslagen SMTP-wachtwoord en de TOTP-inschrijving van het adminaccount
# niet meer ontsleuteld worden.
SETTINGS_ENCRYPTION_KEY="verander-dit-in-een-lange-willekeurige-sleutel"

# --- Cookiebeveiliging ---
# "true" zodra de app achter HTTPS (reverse proxy) draait, anders "false".
COOKIE_SECURE="true"

# --- Web Push (VAPID) ---
# Optioneel: laat leeg om pushnotificaties uit te schakelen (de rest van de
# app blijft dan normaal werken). Genereer met:
#   npx web-push generate-vapid-keys
# Zie de README-sectie "Web Push" voor uitleg en het bewaren bij updates.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:beheer@ringapeldoorn.nl"

# --- Postgres-containerinstellingen (alleen gebruikt door de db-service zelf) ---
POSTGRES_USER="ringtools"
POSTGRES_PASSWORD="verander-dit-wachtwoord"
POSTGRES_DB="ringtools"

PORT=2809

# --- Tests: alleen een afzonderlijke testdatabase (naam eindigt op _test/_ci/_e2e, lokale host). Nooit de productiedatabase. ---
# TEST_DATABASE_URL="postgresql://postgres:…@localhost:5432/ringtools_test?schema=public"
# E2E_DATABASE_URL="postgresql://postgres:…@localhost:5432/ringtools_e2e?schema=public"

# --- E2.1: authenticator-app (TOTP) voor gewone webgebruikers. Standaard UIT; niet aanzetten zonder akkoord van de eigenaar. ---
# WEB_TOTP_ENABLED="false"
# --- Web/PWA v2: de gedeelde interface (dezelfde client als de iOS-app) onder /app, met de sessiecookie op de API. Standaard UIT. ---
# Alleen aanzetten na akkoord van de eigenaar en de beveiligingsbeoordeling in docs/WEB-PWA-PARITEIT.md §9. APP_BASE_URL moet exact de publieke oorsprong zijn.
# WEB_APP_V2_ENABLED="false"
# --- E2.3 fase 1: inloggen in de native app met e-mailcode + authenticator-app (vereist WEB_TOTP_ENABLED). Standaard UIT. ---
# NATIVE_TOTP_LOGIN_ENABLED="false"
# --- E2.3: vertrouwde toestellen (hardwaregebonden sleutel, koppelcode). Standaard UIT. ---
# TRUSTED_DEVICES_ENABLED="false"
# --- Automatisch MFA inschakelen na de eerste bevestigde methode. Standaard UIT; pas aanzetten nadat inloggen in de app met MFA op een toestel is bevestigd. ---
# AUTO_ENABLE_MFA="false"  # werkt per methode alleen samen met NATIVE_TOTP_LOGIN_ENABLED (TOTP) resp. NATIVE_PASSKEYS_ENABLED (passkey)

# --- Native iOS/Android-app (optioneel) ---
# Pushmeldingen naar de app lopen via Expo Push (APNs/FCM-sleutels staan bij Expo/EAS).
# Optioneel: een Expo access token als "Enhanced Push Security" aan staat.
# EXPO_ACCESS_TOKEN=""
# Universele links (e-maillinks openen direct de app). iOS: "<TEAM-ID>.<bundle-id>".
# APPLE_APP_ID="<TEAM-ID>.<bundle-id>"   (Team-ID uit je Apple Developer-account)
# Android: SHA-256-vingerafdruk(ken) van het ondertekeningscertificaat, komma-gescheiden.
# ANDROID_SHA256_FINGERPRINTS=""
# ANDROID_PACKAGE="nl.ringapeldoorn.ringtools"

# --- Native pushmeldingen (iOS/Android-app), optioneel ---
# Android: Firebase service-account-JSON (ruw of base64). iOS: APNs-sleutel (.p8, ruw of base64) met sleutel-ID, team-ID en bundle-ID.
# Zonder deze waarden slaat de server native apparaten over; Web Push blijft werken. Zet hier NOOIT echte sleutels in git.
# FCM_SERVICE_ACCOUNT_JSON=""
# APNS_KEY_P8=""
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_BUNDLE_ID=""
# APNS_PRODUCTION: "true" (standaard) = productie-APNs. TestFlight- en App Store-builds gebruiken ALTIJD productie.
# "false" (sandbox) is alleen voor builds die rechtstreeks vanuit Xcode op een toestel draaien.
# Sleutels staan alleen op de server (Portainer-env of gemount bestand via APNS_KEY_P8_FILE / FCM_SERVICE_ACCOUNT_FILE), nooit in GitHub.
# APNS_PRODUCTION="true"

# --- E2.4a: wachtwoordloos inloggen met een geactiveerd vertrouwd toestel (alleen iPhone). Standaard UIT; vereist TRUSTED_DEVICES_ENABLED. Niet activeren zonder akkoord van de eigenaar (docs/E2-4A-BEVEILIGINGSREVIEW.md). ---
# NATIVE_DEVICE_LOGIN_ENABLED="false"
# E2.5: automatische Face ID-inrichting na de eerste volledige aanmelding (vereist NATIVE_DEVICE_LOGIN_ENABLED en TRUSTED_DEVICES_ENABLED).
# NATIVE_DEVICE_AUTO_ENROLL_ENABLED="false"

# Bestaande installatiekanalen (optioneel; geen verzonnen storelinks):
# IOS_INSTALL_URL=""
# ANDROID_INSTALL_URL=""
