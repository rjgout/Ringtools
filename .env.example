# Kopieer dit bestand naar ".env" voor lokale ontwikkeling.
# Op de NAS zet je deze waarden als environment variables in de Portainer-stack.

# --- Database (PostgreSQL, draait als los onderdeel in dezelfde stack) ---
DATABASE_URL="postgresql://ringtools:verander-dit-wachtwoord@db:5432/ringtools?schema=public"

# --- Basis-URL waarmee de app bereikbaar is (gebruikt in e-maillinks) ---
# Zonder reverse proxy/domein: http://<NAS-IP>:2809
APP_BASE_URL="https://ringapeldoorn.nl"

# --- Admin-account (webmin): wordt éénmalig aangemaakt bij de eerste start. ---
# Een later in de applicatie gewijzigd wachtwoord wordt bij een herstart NOOIT
# overschreven door deze waarde.
BOOTSTRAP_ADMIN_USERNAME="webmin"
BOOTSTRAP_ADMIN_PASSWORD="verander-dit-in-een-sterk-wachtwoord"

# --- Versleuteling van het SMTP-wachtwoord én de TOTP-secrets (MFA) ---
# Verplicht: een lange, willekeurige tekst (bijv. gegenereerd met
# `openssl rand -hex 32`). Bewaar deze goed: zonder deze sleutel kunnen het
# opgeslagen SMTP-wachtwoord en de TOTP-inschrijving van het adminaccount
# niet meer ontsleuteld worden.
SETTINGS_ENCRYPTION_KEY="verander-dit-in-een-lange-willekeurige-sleutel"

# --- Cookiebeveiliging ---
# "true" zodra de app achter HTTPS (reverse proxy) draait, anders "false".
COOKIE_SECURE="true"

# --- Web Push (VAPID) ---
# Optioneel: laat leeg om pushnotificaties uit te schakelen (de rest van de
# app blijft dan normaal werken). Genereer met:
#   npx web-push generate-vapid-keys
# Zie de README-sectie "Web Push" voor uitleg en het bewaren bij updates.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:beheer@ringapeldoorn.nl"

# --- Postgres-containerinstellingen (alleen gebruikt door de db-service zelf) ---
POSTGRES_USER="ringtools"
POSTGRES_PASSWORD="verander-dit-wachtwoord"
POSTGRES_DB="ringtools"

PORT=2809

# --- Native iOS/Android-app (optioneel) ---
# Pushmeldingen naar de app lopen via Expo Push (APNs/FCM-sleutels staan bij Expo/EAS).
# Optioneel: een Expo access token als "Enhanced Push Security" aan staat.
# EXPO_ACCESS_TOKEN=""
# Universele links (e-maillinks openen direct de app). iOS: "<TEAM-ID>.<bundle-id>".
# APPLE_APP_ID="ABCDE12345.nl.ringapeldoorn.ringtools"
# Android: SHA-256-vingerafdruk(ken) van het ondertekeningscertificaat, komma-gescheiden.
# ANDROID_SHA256_FINGERPRINTS=""
# ANDROID_PACKAGE="nl.ringapeldoorn.ringtools"
