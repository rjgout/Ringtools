<!doctype html>
<html lang="nl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="page">
    <h1>Hogeraadsleden</h1>
    <p class="muted">Dit zijn de namen waaruit gekozen kan worden bij het steunen van een roeping.</p>

    <% if (error) { %>
      <p class="alert alert--error"><%= error %></p>
    <% } %>

    <form method="post" action="/members" class="inline-form">
      <input type="text" name="name" placeholder="Naam hogeraadslid" required />
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn btn--primary">Toevoegen</button>
    </form>

    <div class="card-list">
      <% members.forEach(m => { %>
        <div class="card card--row">
          <span><%= m.name %></span>
          <form method="post" action="/members/<%= m.id %>/delete" onsubmit="return confirm('Weet je zeker dat je ' + <%- JSON.stringify(m.name) %> + ' wilt verwijderen?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn--ghost btn--danger">Verwijderen</button>
          </form>
        </div>
      <% }) %>
      <% if (members.length === 0) { %>
        <p class="muted">Nog geen hogeraadsleden toegevoegd.</p>
      <% } %>
    </div>
  </main>
</body>
</html>
